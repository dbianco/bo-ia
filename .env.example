# Puertos en el rango 9100 para evitar choques con otras apps corriendo localmente.

# Postgres (servicio `db`)
POSTGRES_USER=bo_ia
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=bo_ia
POSTGRES_PORT=9100
DATABASE_URL=postgresql+psycopg://bo_ia:dev_only_change_me@db:5432/bo_ia

# Backend (servicio `backend`: Ingestor + Procesador + API)
BACKEND_PORT=9101
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_CACHE_DIR=/model-cache
SIMILARITY_THRESHOLD=0.5
# Ruta (dentro del contenedor) a la configuración de instalación: nombre,
# fuentes iniciales y filtros declarados de esta instalación (ver
# docs/superpowers/specs/2026-09-18-plataforma-tematica-reutilizable-design.md).
INSTALLATION_CONFIG=/app/installation.yaml
# SMTP para el canal "correo" de las notificaciones (Etapa 4). Opcional:
# si SMTP_HOST queda vacío, ese canal falla de forma controlada y
# "bandeja" sigue funcionando igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=avisos@bo-ia.local

# Web (servicio `web`: interfaz de búsqueda)
WEB_PORT=9102
BACKEND_INTERNAL_URL=http://backend:8000
