# Puertos en el rango 9100 para evitar choques con otras apps corriendo localmente.

# Postgres (servicio `db`)
POSTGRES_USER=bo_ia
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=bo_ia
POSTGRES_PORT=9100
DATABASE_URL=postgresql+psycopg://bo_ia:dev_only_change_me@db:5432/bo_ia

# Backend (servicio `backend`: Ingestor + Procesador + API)
BACKEND_PORT=9101
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_CACHE_DIR=/model-cache
SIMILARITY_THRESHOLD=0.5

# Web (servicio `web`: interfaz de búsqueda)
WEB_PORT=9102
BACKEND_INTERNAL_URL=http://backend:8000
