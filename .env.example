# Puertos en el rango 9100 para evitar choques con otras apps corriendo localmente.

# Postgres (servicio `db`)
POSTGRES_USER=bo_ia
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=bo_ia
POSTGRES_PORT=9100
DATABASE_URL=postgresql+psycopg://bo_ia:dev_only_change_me@db:5432/bo_ia

# Backend (servicio `backend`: Ingestor + Procesador + API)
BACKEND_PORT=9101
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_CACHE_DIR=/model-cache
# model (default, the real one), hashed (offline, for development) or
# precomputed (EMBEDDING_PRECOMPUTED: a vector file). Do not change it on a
# database that already has documents: vectors of two providers do not compare.
EMBEDDING_PROVIDER=model
EMBEDDING_SEED=0
EMBEDDING_SYNONYMS=
EMBEDDING_PRECOMPUTED=
# Secret that POST /v1/documentos and POST /v1/fuentes/{clave}/ejecutar require
# (Authorization: Bearer ...). Empty: both are closed to everybody. The scheduler
# does not need it. Generate one with: openssl rand -hex 32
OPERATOR_TOKEN=
SIMILARITY_THRESHOLD=0.5
# How documents are matched against subscriptions: indexed (an index in memory)
# or loop (one query per subscription, the reference).
MATCHING_ENGINE=indexed
# Seconds between one look at the queue of documents to match and the next.
MATCHING_POLL_SECONDS=1
# Who answers searches: postgres, or engine (in memory: some 5.5 GB per million
# fragments, and it is loaded again at every start).
SEARCH_ENGINE=postgres
# Weights of the vector and the text rankings, only for engine.
RRF_WEIGHTS=1,1
# Ruta (dentro del contenedor) a la configuración de instalación: nombre,
# fuentes iniciales y filtros declarados de esta instalación (ver
# docs/design/2026-09-18-plataforma-tematica-reutilizable-design.md).
INSTALLATION_CONFIG=/app/installation.yaml
# SMTP para el canal "correo" de las notificaciones (Etapa 4). Opcional:
# si SMTP_HOST queda vacío, ese canal falla de forma controlada y
# "bandeja" sigue funcionando igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=avisos@contextcrawl.local
# starttls (default), ssl or none. none is only for a server on the same machine.
SMTP_SECURITY=starttls
# Address of the web, as its users see it: the emails link to it.
PUBLIC_WEB_URL=http://localhost:9102
# Secret that signs the links to pause a subscription from an email. Empty: the
# emails have no such link. Generate one with: openssl rand -hex 32
LINK_SECRET=
# Local hour (0-23) at which the daily and weekly digests are made. The time zone
# is in the installation file.
DIGEST_HOUR=7
# How many times an email is tried again, waiting up to an hour between them.
EMAIL_MAX_RETRIES=48
# Seconds between one look at the emails to send and the next.
NOTIFICATIONS_POLL_SECONDS=5

# Limits by address of what anybody can call: a number and second, minute, hour or
# day; or off. Empty: the default, in brackets.
# Searches [60/minute]
RATE_LIMIT_SEARCH=
# Ratings of a result [30/minute]
RATE_LIMIT_RATINGS=
# New accounts [10/hour]
RATE_LIMIT_REGISTER=
# Signing in [10/minute]
RATE_LIMIT_LOGIN=
# The rest: configuration, issues, signing out, links of the emails [120/minute]
RATE_LIMIT_PUBLIC=
# Who may say, with X-Forwarded-For, whose request it is: addresses, networks or
# host names, separated by commas. The web is one.
TRUSTED_PROXIES=web

# Web (servicio `web`: interfaz de búsqueda)
WEB_PORT=9102
# Addresses of a reverse proxy in front of the web, if there is one, so that the web
# knows who its visitors are.
FORWARDED_ALLOW_IPS=127.0.0.1
BACKEND_INTERNAL_URL=http://backend:8000
