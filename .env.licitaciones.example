# Segundo stack real, en paralelo al de "Boletines Córdoba" (Etapa 5 —
# segundo vertical). Puertos en el rango 9300 para no chocar con el stack
# de boletines (rango 9100, ver .env.example) ni con otras apps locales.
#
# Uso: cp .env.licitaciones.example .env.licitaciones && \
#   docker compose -p bo-ia-licitaciones --env-file .env.licitaciones \
#     -f docker-compose.yml -f docker-compose.licitaciones.override.yml \
#     up -d --build

# Postgres (servicio `db`) — base de datos propia, separada de la del
# stack de boletines.
POSTGRES_USER=bo_ia
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=bo_ia_licitaciones
POSTGRES_PORT=9300
DATABASE_URL=postgresql+psycopg://bo_ia:dev_only_change_me@db:5432/bo_ia_licitaciones

# Backend (servicio `backend`: Ingestor + Procesador + API)
BACKEND_PORT=9301
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_CACHE_DIR=/model-cache
SIMILARITY_THRESHOLD=0.5
# Ruta DENTRO del contenedor; el archivo real montado ahí lo define
# docker-compose.licitaciones.override.yml (installation-licitaciones.yaml
# en vez de installation.yaml) — no hace falta cambiar este valor.
INSTALLATION_CONFIG=/app/installation.yaml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=avisos@bo-ia.local

# Web (servicio `web`: interfaz de búsqueda)
WEB_PORT=9302
BACKEND_INTERNAL_URL=http://backend:8000
